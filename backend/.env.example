# ============================================================================
# Backend environment configuration — copy to `backend/.env` and fill in.
# Never commit the real `.env` file. Keep secret keys server-side only.
# ============================================================================

# Port the Express API + static frontend listens on.
PORT=4000

# Node environment.
NODE_ENV=development

# ---- Supabase project credentials (from your Supabase dashboard) ----
# Project Settings → API. The anon key is safe for the client; the service
# role key is secret and must stay server-side.
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ---- Security / CORS ----
# The approved frontend origin. Defaults to same-origin serving (http://localhost:4000).
# If you host the frontend separately (e.g. Vercel), set this to that origin.
FRONTEND_ORIGIN=http://localhost:4000

# ---- Schedule time zone ----
# One clearly defined time zone for the provider's schedule (proposal section 10).
# Use an IANA name (e.g. America/New_York, Europe/London, Africa/Lagos).
SCHEDULE_TIMEZONE=UTC
